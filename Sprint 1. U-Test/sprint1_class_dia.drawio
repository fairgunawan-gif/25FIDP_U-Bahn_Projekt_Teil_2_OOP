        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass Station {\n    +name: str\n    +__repr__(): str\n}\n\nclass Connection {\n    +destination: Station\n    +travel_time_minutes: int\n}\n\nclass Line {\n    +adjacency: Dict[Station, List[Connection]]\n    +add_station(station: Station): void\n    +connect(from_station: Station, to_station: Station, minutes: int): void\n    +get_travel_time_from_start(start: Station, target: Station): int\n}\n\nclass TimetableService {\n    +first_departure: time\n    +last_departure: time\n    +interval_minutes: int\n    +line: Line\n    +get_next_departure(station: Station, desired_time: time): time\n}\n\nclass ConsoleUI {\n    +read_station(): Station\n    +read_time(): time\n    +run(): void\n}\n\nStation \&quot;1\&quot; &lt;-- \&quot;*\&quot; Connection : destination\nLine \&quot;1\&quot; o-- \&quot;*\&quot; Station\nLine \&quot;1\&quot; o-- \&quot;*\&quot; Connection\nTimetableService --&gt; Line\nConsoleUI --&gt; TimetableService\nConsoleUI --&gt; Station\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="uphh9EH9_-5Vkm6OEEgy-2">
